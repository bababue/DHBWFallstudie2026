[Unit]
Description=MoosProjekt Python Script
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=moos
WorkingDirectory=/home/moos/DHBWFallstudie2026
ExecStart=/home/moos/DHBWFallstudie2026/.venv/bin/python -u /home/moos/DHBWFallstudie2026/src/main.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
