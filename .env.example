# Raspberry Pi 5 GPIO chip; GPIO numbers are BCM numbers.
GPIOCHIP_DEVICE=/dev/gpiochip0
LEFT_I2C_SDA_GPIO=15
LEFT_I2C_SCL_GPIO=14
RIGHT_I2C_SDA_GPIO=23
RIGHT_I2C_SCL_GPIO=24
WATER_TRIGGER_GPIO=6
WATER_ECHO_GPIO=13
WATER_FLOOR_DISTANCE_CM=8.62
# Four sensors above the moss. Empty distance = sensor to bare substrate (cm).
MOSS_1_TRIGGER_GPIO=9
MOSS_1_ECHO_GPIO=11
MOSS_1_EMPTY_DISTANCE_CM=
MOSS_2_TRIGGER_GPIO=0
MOSS_2_ECHO_GPIO=5
MOSS_2_EMPTY_DISTANCE_CM=
I2C_DELAY_US=12

# Both software I2C buses have the same sensor addresses.
SHT45_ADDRESS=0x44
BH1750_ADDRESS=0x23
SCD40_ADDRESS=0x62

# Sampling and storage. SCD40 itself produces a fresh CO2 value every 5 s.
FAST_SAMPLE_INTERVAL_SECONDS=1
MOSS_SAMPLE_INTERVAL_SECONDS=4
CO2_READY_POLL_SECONDS=0.5
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_ORG=moos
INFLUXDB_BUCKET=moos_sensors
INFLUXDB_USERNAME=moos
INFLUXDB_PASSWORD=ohnemoosnixlos
# Example token for a NEW InfluxDB volume. Existing volumes keep their original token.
INFLUXDB_TOKEN=e6f5731561f2b702d8966cf6b27b43162789c6ede71c315d16f0c8dec259ae6e

# Plain HTML dashboard.
DASHBOARD_POLL_SECONDS=0.5
DASHBOARD_MAX_AGE_SECONDS=12

# Web controls.
ACTUATORS_ENABLED=true
LED_GPIO=20
FAN_GPIO=21
PUMP_GPIO=16
LED_PWM_HZ=2000
FAN_PWM_HZ=5
PUMP_PWM_HZ=5

# Camera MJPEG stream, served by the camera container.
CAMERA_PORT=8000
