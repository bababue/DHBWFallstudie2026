# Raspberry Pi 5 GPIO chip; GPIO numbers are BCM numbers.
GPIOCHIP_DEVICE=/dev/gpiochip0
LEFT_I2C_SDA_GPIO=15
LEFT_I2C_SCL_GPIO=14
RIGHT_I2C_SDA_GPIO=23
RIGHT_I2C_SCL_GPIO=24
I2C_DELAY_US=12

# Both software I2C buses have the same sensor addresses.
SHT45_ADDRESS=0x44
BH1750_ADDRESS=0x23
SCD40_ADDRESS=0x62
B24_1_GPIO=12
B24_1_ENABLED=false

# Sampling and storage.
SAMPLE_INTERVAL_SECONDS=30
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_ORG=moos
INFLUXDB_BUCKET=moos_sensors
INFLUXDB_USERNAME=moos
INFLUXDB_PASSWORD=replace-with-a-long-password
INFLUXDB_TOKEN=replace-with-a-long-random-token
GRAFANA_ADMIN_PASSWORD=replace-with-another-long-password

# Plain HTML dashboard.
DASHBOARD_REFRESH_SECONDS=30
DASHBOARD_MAX_AGE_SECONDS=180
